{
  "compilerOptions": {
    "outDir": "./dist/",
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    },
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "module": "ESNext",
    "target": "ES2015",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
